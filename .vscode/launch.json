  "configurations": [
    {
      "name": "Run Debug (g++)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/main_debug.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
