{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Debug Editor",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/editor_debug.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/lib;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/MinGW/bin/gdb.exe",
      "preLaunchTask": "build-debug"
    },
    {
      "name": "Run Release Editor",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/editor_release.exe",
